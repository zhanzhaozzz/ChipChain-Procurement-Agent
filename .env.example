# 主模型 deepseek-v4-pro 与摘要模型 deepseek-v4-flash 共用凭据。
# 模型名称/参数在 src/agent/config.py 中配置。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# 可选：仅用于 web_search，不初始化额外的聊天模型。
BOCHA_API_KEY=
SANDBOX_API_KEY=
# OpenSandbox Server 地址；端口转发模式可填写 http://127.0.0.1:18080。
SANDBOX_DOMAIN=http://localhost:8080
# 可选：由 start_web.py 自动以无界面模式启动现有 VirtualBox 虚拟机。
SANDBOX_VM_NAME=
SANDBOX_VM_START_TIMEOUT=180
# VBoxManage 不在默认安装目录或 PATH 时填写完整路径。
VBOX_MANAGE=
# OpenSandbox 位于独立虚拟机或远程主机时建议开启，由服务端统一代理动态端口。
SANDBOX_USE_SERVER_PROXY=false
# 多用户场景开启：预热沙箱被认领后、有新用户到来时惰性补充预热沙箱。
SANDBOX_PREWARM_REPLENISH=true

# ERP 与可视化 MCP（先启动 Java 后端和 ERP MCP 服务）。
JAVA_API_BASE_URL=http://localhost:8082/api
# 使用 Java 平台中 role=agent 的最小权限服务账号，禁止配置管理员账号。
JAVA_API_USERNAME=procurement_agent
JAVA_API_PASSWORD=
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
# 未填写时由 MCP_HOST、MCP_PORT、MCP_PATH 计算。
ERP_MCP_URL=
ANALYSIS_MCP_URL=

# Agent 会话、账号与沙箱绑定存储。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=agent_db
MYSQL_CONNECT_TIMEOUT=5
MYSQL_AUTO_CREATE_DATABASE=true
# 决策证据详细载荷保留天数；活动 retention hold 会阻止清理。
DECISION_EVIDENCE_RETENTION_DAYS=90
ORDER_RECONCILIATION_MAX_ATTEMPTS=3
# Safer default: only operators that accept an exact same-key retry enable this.
ORDER_RECONCILIATION_RETRY_IF_ABSENT=false
# 逗号分隔 username=capability|capability；留空即所有窄权限默认拒绝。
# 允许值：decision:audit、evaluation:view、evaluation:maintain。
APP_CAPABILITY_BOOTSTRAP=
# 额外需要禁止进入证据的字段名，逗号分隔。
EVIDENCE_SECRET_FIELDS=
# MCP 访问 Agent 决策表的独立最小权限账号；不得使用 ERP 或 MySQL root 账号。
DECISION_DB_HOST=localhost
DECISION_DB_PORT=3306
DECISION_DB_USER=chipchain_mcp
DECISION_DB_PASSWORD=
DECISION_DB_NAME=agent_db
# Agent API 与 MCP 共享，至少 32 字节；不要提交真实值。
MCP_INVOCATION_SIGNING_SECRET=

# HTTPS 部署时设置 true；本地 HTTP 保持 false。
AUTH_COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
APP_ENV=development
# 应用日志级别；DEBUG 显示 MCP 加载、沙箱执行等细节。
# production 环境同时追加写入 erp_agent.log。
LOG_LEVEL=INFO
# 单独启动 Vite 时可配置代理；start_web.py 固定使用 8090/3000。
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8090
FRONTEND_PORT=3000

# Per-process runtime preparation (Windows-native + VirtualBox)
# Simple chat / allowlisted read-only queries skip sandbox acquisition.
# Login defers per-user preparation until a full-path request needs it.
AGENT_REQUEST_ROUTING_ENABLED=true
# Rules first; unresolved requests use deepseek-flash with the existing DeepSeek provider.
# Classifier timeout/errors/invalid output conservatively retain the full sandbox path.
AGENT_REQUEST_ROUTER_LLM_ENABLED=true
AGENT_REQUEST_ROUTER_TIMEOUT_SECONDS=5
SANDBOX_HEALTH_CACHE_TTL_SECONDS=45
SANDBOX_PREWARM_TARGET=2
SANDBOX_PREWARM_CONCURRENCY=1
AGENT_BACKGROUND_PREPARE_ENABLED=true
AGENT_PREPARE_CONCURRENCY=2
AGENT_PREPARE_MAX_PENDING=32
AGENT_GRAPH_CACHE_ENABLED=true
AGENT_GRAPH_CACHE_MAX_USERS=32
AGENT_GRAPH_CACHE_IDLE_SECONDS=1800
