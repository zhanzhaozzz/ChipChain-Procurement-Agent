        <mxCell id="edge-2" value="" edge="1" parent="input_layer" source="inputguard" target="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#D59A20;strokeWidth=2;fontColor=#D59A20;fontSize=19;defaultLabelBackgroundColor=page;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="拒绝" edge="1" parent="input_layer" source="decision" target="deny" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#D25B70;strokeWidth=2;fontColor=#D25B70;fontSize=19;defaultLabelBackgroundColor=page;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
