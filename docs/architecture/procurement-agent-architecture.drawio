  <diagram id="page-2" name="02 安全与 ERP 调用链">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1900" pageHeight="1690" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="安全护栏与 Java ERP 调用链" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=38;fontColor=#0F172A;fontStyle=1;">
          <mxGeometry x="60" y="35" width="1810" height="55" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="输入检查 → Agent 路由 → 写操作审批 → MCP 适配 → Java REST API" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#64748B;fontStyle=0;">
          <mxGeometry x="60" y="95" width="1810" height="35" as="geometry" />
        </mxCell>
        <mxCell id="note-0" value="安全检查不通过：不进入业务 Agent，也不调用 Java ERP。问候固定回复仍先通过全部安全检查。" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#64748B;fontStyle=0;">
          <mxGeometry x="65" y="1594" width="1805" height="35" as="geometry" />
        </mxCell>
        <mxCell id="note-1" value="approve 后从 checkpoint 恢复并执行原工具参数；业务结果沿 MCP → Agent → SSE 返回前端。" vertex="1" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=22;fontColor=#64748B;fontStyle=0;">
          <mxGeometry x="65" y="1634" width="1805" height="35" as="geometry" />
        </mxCell>
        <mxCell id="input_layer" value="第一道边界 · 身份 / 会话授权与输入安全检查" vertex="1" parent="1" style="swimlane;html=1;startSize=48;rounded=1;arcSize=10;horizontal=1;collapsible=0;fillColor=#FFFBEB;swimlaneFillColor=#FFFBEB;strokeColor=#D59A20;fontColor=#854D0E;fontFamily=Arial;fontSize=21;align=left;spacingLeft=20;fontStyle=1;">
          <mxGeometry x="50" y="180" width="1800" height="550" as="geometry" />
        </mxCell>
        <mxCell id="operation_layer" value="订单执行与审批" vertex="1" parent="1" style="swimlane;html=1;startSize=48;rounded=1;arcSize=10;horizontal=1;collapsible=0;fillColor=#EFF6FF;swimlaneFillColor=#EFF6FF;strokeColor=#3B82F6;fontColor=#1E3A8A;fontFamily=Arial;fontSize=21;align=left;spacingLeft=20;fontStyle=1;">
          <mxGeometry x="50" y="835" width="1800" height="720" as="geometry" />
        </mxCell>
        <mxCell id="request" value="&lt;div style=&quot;font-size:25px;color:#1E3A8A;font-weight:bold;margin-bottom:12px&quot;&gt;用户请求&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;新消息 / 补充文本&lt;br&gt;/chat/stream 或 /resume&lt;/div&gt;" vertex="1" parent="input_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="40" y="80" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="auth" value="&lt;div style=&quot;font-size:25px;color:#1E3A8A;font-weight:bold;margin-bottom:12px&quot;&gt;身份与会话归属校验&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;Cookie 登录认证&lt;br&gt;会话归属 / 同源请求校验&lt;br&gt;未登录 401；无权限 404&lt;/div&gt;" vertex="1" parent="input_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="380" y="65" width="310" height="160" as="geometry" />
        </mxCell>
        <mxCell id="inputguard" value="&lt;div style=&quot;font-size:25px;color:#854D0E;font-weight:bold;margin-bottom:12px&quot;&gt;NeMo Guardrails · INPUT&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;本地长度 / 控制字符校验&lt;br&gt;self check input：独立 LLM 审查&lt;br&gt;Colang 业务规则 → greeting 流程&lt;/div&gt;" vertex="1" parent="input_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#D59A20;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="750" y="60" width="420" height="170" as="geometry" />
        </mxCell>
        <mxCell id="decision" value="&lt;div style=&quot;font-size:25px;color:#854D0E;font-weight:bold;margin-bottom:12px&quot;&gt;检查结果&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;按状态分流&lt;/div&gt;" vertex="1" parent="input_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#D59A20;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="1250" y="95" width="180" height="100" as="geometry" />
        </mxCell>
        <mxCell id="deny" value="&lt;div style=&quot;font-size:25px;color:#9F1239;font-weight:bold;margin-bottom:12px&quot;&gt;阻断业务执行&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;403：安全规则拒绝&lt;br&gt;422：输入 / 参数错误&lt;br&gt;503：审查异常或超时&lt;/div&gt;" vertex="1" parent="input_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E07483;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="1490" y="60" width="270" height="170" as="geometry" />
        </mxCell>
        <mxCell id="resume" value="&lt;div style=&quot;font-size:25px;color:#334155;font-weight:bold;margin-bottom:12px&quot;&gt;恢复请求的约束&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;补充文本：再次经过输入安全检查&lt;br&gt;审批决策：仅 approve / reject，不能改写工具参数&lt;br&gt;恢复前检查会话归属，使用原会话 checkpoint&lt;/div&gt;" vertex="1" parent="input_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#A6B3C3;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="40" y="340" width="650" height="150" as="geometry" />
        </mxCell>
        <mxCell id="dispatch" value="&lt;div style=&quot;font-size:25px;color:#1E3A8A;font-weight:bold;margin-bottom:12px&quot;&gt;主 Agent → 订单子 Agent&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;安全检查通过后执行业务&lt;br&gt;识别意图，准备工具参数&lt;/div&gt;" vertex="1" parent="input_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="750" y="340" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="greeting" value="&lt;div style=&quot;font-size:25px;color:#065F46;font-weight:bold;margin-bottom:12px&quot;&gt;问候命中 → 固定回复&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;GuardrailResponseMiddleware 写入 AIMessage&lt;br&gt;跳过业务 LLM，保存会话并返回 SSE&lt;/div&gt;" vertex="1" parent="input_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#159A78;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="1250" y="340" width="510" height="140" as="geometry" />
        </mxCell>
        <mxCell id="query" value="&lt;div style=&quot;font-size:25px;color:#065F46;font-weight:bold;margin-bottom:12px&quot;&gt;订单查询&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;order_search_details&lt;br&gt;无需写操作审批&lt;/div&gt;" vertex="1" parent="operation_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#159A78;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="40" y="80" width="380" height="130" as="geometry" />
        </mxCell>
        <mxCell id="write" value="&lt;div style=&quot;font-size:25px;color:#1E3A8A;font-weight:bold;margin-bottom:12px&quot;&gt;创建 / 修改采购单&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;order_create / order_update&lt;br&gt;缺字段时 request_order_info 请求补充&lt;/div&gt;" vertex="1" parent="operation_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="750" y="80" width="420" height="130" as="geometry" />
        </mxCell>
        <mxCell id="approval" value="&lt;div style=&quot;font-size:25px;color:#854D0E;font-weight:bold;margin-bottom:12px&quot;&gt;HITL 人工审批&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;interrupt_on → SSE 审批卡片&lt;br&gt;用户决策通过 /resume 恢复执行&lt;/div&gt;" vertex="1" parent="operation_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#D59A20;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="750" y="305" width="420" height="140" as="geometry" />
        </mxCell>
        <mxCell id="reject" value="&lt;div style=&quot;font-size:25px;color:#9F1239;font-weight:bold;margin-bottom:12px&quot;&gt;reject：终止本次写入&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;不调用 Java 创建 / 修改接口&lt;br&gt;将拒绝结果返回对话&lt;/div&gt;" vertex="1" parent="operation_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#E07483;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="1250" y="305" width="460" height="140" as="geometry" />
        </mxCell>
        <mxCell id="mcp" value="&lt;div style=&quot;font-size:25px;color:#065F46;font-weight:bold;margin-bottom:12px&quot;&gt;ERP MCP Server&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;Streamable HTTP / FastMCP&lt;br&gt;snake_case → Java camelCase&lt;br&gt;httpx.AsyncClient 调用 REST API&lt;/div&gt;" vertex="1" parent="operation_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#159A78;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="750" y="545" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="java" value="&lt;div style=&quot;font-size:25px;color:#065F46;font-weight:bold;margin-bottom:12px&quot;&gt;Java ERP REST API&lt;/div&gt;&lt;div style=&quot;font-size:20px;color:#475569;line-height:1.45&quot;&gt;GET /orders/search-details&lt;br&gt;POST /orders/create&lt;br&gt;PUT /orders/update/{order_id}&lt;/div&gt;" vertex="1" parent="operation_layer" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#159A78;strokeWidth=2;fontFamily=Arial;fontSize=20;spacing=14;">
          <mxGeometry x="1250" y="545" width="460" height="150" as="geometry" />
        </mxCell>
        <mxCell id="edge-0" value="请求" edge="1" parent="input_layer" source="request" target="auth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#64748B;fontSize=19;defaultLabelBackgroundColor=page;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
