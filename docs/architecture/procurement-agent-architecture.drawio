        <mxCell id="edge-15" value="REST" edge="1" parent="1" source="erpmcp" target="java" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#159A78;strokeWidth=2;fontColor=#159A78;fontSize=19;defaultLabelBackgroundColor=page;labelBackgroundColor=#FFFFFF;dashed=0;">
          <mxGeometry relative="1" as="geometry" />
