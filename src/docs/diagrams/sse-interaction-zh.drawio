        <mxCell id="E" value="前端按调用 ID 关联&lt;br&gt;最终答复 / 执行过程 / 图片" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#5b8bd9;fontColor=#172b4d;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="680" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="F" value="人工中断组件&lt;br&gt;补充信息或同意拒绝" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#5b8bd9;fontColor=#172b4d;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="680" width="220" height="80" as="geometry" />
