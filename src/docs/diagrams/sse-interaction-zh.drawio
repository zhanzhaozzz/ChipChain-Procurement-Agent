<mxfile host="app.diagrams.net">
  <diagram id="SSE 展示与人工交互闭环" name="SSE 展示与人工交互闭环">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="A" value="浏览器 fetch POST&lt;br&gt;Cookie + 请求正文" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#5b8bd9;fontColor=#172b4d;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="B" value="FastAPI&lt;br&gt;认证 / 归属 / 输入检查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#45a38b;fontColor=#172b4d;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="200" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="C" value="Agent astream&lt;br&gt;模型消息 + 图状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0ebff;strokeColor=#8b73c8;fontColor=#172b4d;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="360" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="D" value="SSE 事件&lt;br&gt;token / tool_* / interrupt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3df;strokeColor=#d7a149;fontColor=#172b4d;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="520" width="220" height="80" as="geometry" />
