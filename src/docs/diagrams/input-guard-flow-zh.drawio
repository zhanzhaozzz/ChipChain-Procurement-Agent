        <mxCell id="C" value="语义审查允许？" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0ebff;strokeColor=#8b73c8;fontColor=#172b4d;fontSize=14;spacing=8;rhombus;" vertex="1" parent="1">
          <mxGeometry x="340" y="360" width="220" height="100" as="geometry" />
