<mxfile host="app.diagrams.net">
  <diagram id="输入检查与业务分流" name="输入检查与业务分流">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="A" value="聊天请求&lt;br&gt;认证与会话归属校验" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#5b8bd9;fontColor=#172b4d;fontSize=14;spacing=8;" vertex="1" parent="1">
