<mxfile host="app.diagrams.net">
  <diagram id="补充信息与审批恢复" name="补充信息与审批恢复">
    <mxGraphModel adaptiveColors="auto" grid="1" gridSize="10" page="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="A" value="恢复请求&lt;br&gt;认证并校验会话归属" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#5b8bd9;fontColor=#172b4d;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="B" value="resume 输入类型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0ebff;strokeColor=#8b73c8;fontColor=#172b4d;fontSize=14;spacing=8;rhombus;" vertex="1" parent="1">
          <mxGeometry x="340" y="200" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="C" value="仅含 supplement&lt;br&gt;文本走完整输入护栏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#45a38b;fontColor=#172b4d;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="D" value="仅含 decisions&lt;br&gt;1–20 项 / 每项仅 type&lt;br&gt;approve 或 reject" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f6f1;strokeColor=#45a38b;fontColor=#172b4d;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="640" y="360" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="E" value="422 格式错误&lt;br&gt;混合字段或其他结构" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=14;spacing=8;ellipse;" vertex="1" parent="1">
          <mxGeometry x="340" y="360" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="F" value="Command resume&lt;br&gt;从原中断点继续" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf2ff;strokeColor=#5b8bd9;fontColor=#172b4d;fontSize=14;spacing=8;ellipse;" vertex="1" parent="1">
          <mxGeometry x="340" y="680" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="G" value="停止文本补充&lt;br&gt;422 / 403 / 503" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=14;spacing=8;ellipse;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="H" value="停止审批恢复&lt;br&gt;结构错误 422 / 配置错误 503" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#172b4d;fontSize=14;spacing=8;ellipse;" vertex="1" parent="1">
          <mxGeometry x="640" y="520" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge0" source="A" target="B" value="归属通过" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;fontColor=#334155;fontSize=12;defaultLabelBackgroundColor=page;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge1" source="B" target="C" value="补充信息" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;fontColor=#334155;fontSize=12;defaultLabelBackgroundColor=page;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry" />
